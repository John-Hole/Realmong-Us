{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "images": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "status"],
        "creatorId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'))"
        },
        "currentRound": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren()",
          "round": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
          },
          "game_status": {
            ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'emergency' || newData.val() === 'discussion' || newData.val() === 'voting' || newData.val() === 'voting_results' || newData.val() === 'crewmates_win' || newData.val() === 'impostors_win'))"
          }
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$playerName": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "votes": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$playerName": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "rateLimit": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "publicMetadata": {
      ".read": true,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}
