{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/schermi-test",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/schermi-test.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
